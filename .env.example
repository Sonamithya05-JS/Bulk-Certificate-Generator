# Copy this file to ".env" to change the defaults. Every value is optional.

# SQLite file location (relative paths are relative to where you start the app)
DATABASE_URL=sqlite:///./bulk_certificates.db

# Folder where PDF certificates are stored (relative paths are relative to the project root)
CERTIFICATES_DIR=generated_certificates

# Maximum number of recipients accepted in ONE request
MAX_RECIPIENTS_PER_JOB=1000

# Server settings used by run.py
HOST=127.0.0.1
PORT=8000
